# REQUIRED — SEC EDGAR demands a real contact email in the User-Agent header.
SEC_USER_AGENT="Your Name your@email.com"

# REQUIRED for the Advisor /api/chat endpoint.
# Get one at console.anthropic.com (starts with sk-ant-...)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# Comma-separated list of allowed origins. Use * for dev, your Vercel domain in prod.
# Example: ALLOWED_ORIGINS=https://innermost.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*

# Port (Railway/Render auto-set this; default 3000 locally)
PORT=3000
